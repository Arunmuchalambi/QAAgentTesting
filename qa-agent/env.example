# ===========================================
# QA Agent - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your credentials

# -------------------------------------------
# JIRA CONFIGURATION
# -------------------------------------------
# Your Jira instance URL (e.g., https://yourcompany.atlassian.net)
JIRA_SERVER=https://your-domain.atlassian.net

# Your Jira email address
JIRA_EMAIL=your-email@company.com

# Jira API Token (generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token

# Jira Project Key (e.g., PROJ, QA, DEV)
JIRA_PROJECT_KEY=PROJ

# -------------------------------------------
# GITHUB CONFIGURATION
# -------------------------------------------
# GitHub Personal Access Token 
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=your-github-personal-access-token

# Default GitHub Repository (format: owner/repo)
GITHUB_REPO=your-org/your-repo

# GitHub API Base URL (for GitHub Enterprise, change this)
GITHUB_API_URL=https://api.github.com

# GitHub Organizations to search for PRs (comma-separated)
# The agent will search ALL repos in these orgs for PRs linked to Jira issues
GITHUB_ORGANIZATIONS=your-org

# -------------------------------------------
# LLM CONFIGURATION (OpenAI-compatible)
# -------------------------------------------
# Provider: gemini (free) | groq (free) | openai (paid)
LLM_PROVIDER=gemini

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional Groq key: https://console.groq.com/keys
# GROQ_API_KEY=your-groq-api-key

# Optional paid OpenAI
# OPENAI_API_KEY=sk-your-openai-api-key

# Optional overrides (defaults: gemini-2.0-flash / llama-3.3-70b-versatile / gpt-4o)
# LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# -------------------------------------------
# WEBHOOK CONFIGURATION
# -------------------------------------------
# Port for the webhook server
WEBHOOK_PORT=8000

# Webhook secret for Jira (optional, for security)
JIRA_WEBHOOK_SECRET=your-webhook-secret

# -------------------------------------------
# AGENT CONFIGURATION
# -------------------------------------------
# Maximum files to read from repository
MAX_FILES_TO_READ=20

# File extensions to include for analysis
INCLUDE_EXTENSIONS=.py,.js,.ts,.java,.go,.rs,.cpp,.c,.h,.jsx,.tsx

# Directories to exclude
EXCLUDE_DIRS=node_modules,venv,.git,__pycache__,dist,build,.next

# Output directory for generated test cases
OUTPUT_DIR=./generated_tests


# -------------------------------------------
# GOOGLE SHEETS (optional)
# -------------------------------------------
# Spreadsheet ID from: docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=your-sheet-id
# Place service account JSON as google_credentials.json in this folder
