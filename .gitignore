# Credentials / secrets (never commit)
.env
.env.*
!.env.example
credentials.env
**/credentials*.json
google_credentials.json
**/google_credentials*.json
slack_config.json
*.pem
*.p12
*.key
id_rsa
id_rsa.pub
!**/*.example.*
!**/*.example.json
!**/.github/**
# Runtime / local
*.log
__pycache__/
venv/
.venv/
test_reports/
generated_tests/
*.pyc
.DS_Store
.pytest_cache/
processed_prs_tracking.json

# Nested qa-agent paths
qa-agent/.env
qa-agent/.env.*
!qa-agent/env.example
qa-agent/credentials.env
qa-agent/google_credentials.json
qa-agent/slack_config.json
qa-agent/__pycache__/
qa-agent/test_reports/
qa-agent/generated_tests/
qa-agent/.pytest_cache/
qa-agent/*.log
qa-agent/venv/
qa-agent/processed_prs_tracking.json
